# Keeps formatting consistent across editors (VS Code, PyCharm, Vim, ...).
# Python uses 4 spaces, the frontend uses 2 - matching each ecosystem's style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
