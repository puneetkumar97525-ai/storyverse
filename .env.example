# Docker Compose variables - copy this file to .env in the repository root:
#   cp .env.example .env
#
# The root .env is read by docker-compose.yml only. It is git-ignored.
# Choose your own local password; nothing here is a real secret.

# --- PostgreSQL container -------------------------------------------------
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=storyverse
POSTGRES_PORT=5432

# --- Host ports published by docker compose ------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
