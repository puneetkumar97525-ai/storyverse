# ---------------------------------------------------------------------------
# StoryVerse - root .gitignore
# ---------------------------------------------------------------------------
# Rule of thumb: anything generated (dependencies, builds, caches) or secret
# (.env files, credentials) stays out of Git. Commit the .env.example files.

# --- Secrets & local configuration --------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.netrc

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Node / frontend -----------------------------------------------------
node_modules/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# --- Editors & OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# --- Logs & temporary files ---------------------------------------------
*.log
logs/
tmp/
temp/
.cache/

# --- Database / Docker ---------------------------------------------------
*.sqlite3
*.db
pgdata/
