# Copy this file to backend/.env and adjust the values for your machine:
#   cp backend/.env.example backend/.env
#
# .env is git-ignored. Never commit real credentials.
# The API reads these variables through app/core/config.py.

# --- Application ---------------------------------------------------------
APP_NAME=StoryVerse API
APP_VERSION=0.1.0
# development | test | staging | production
ENVIRONMENT=development
# Keep false locally. Enables verbose framework debug output when true.
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS ----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ----------------------------------------------------------
# Must match the values in the repository root .env (used by docker compose).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=storyverse
# Seconds to wait before giving up when connecting (fail fast).
POSTGRES_CONNECT_TIMEOUT=5

# Optional: full SQLAlchemy URL that overrides all POSTGRES_* values above.
# Handy for a managed database that gives you a ready-made DSN.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
