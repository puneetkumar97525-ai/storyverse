# Copy this file to frontend/.env.local and adjust if needed:
#   cp frontend/.env.example frontend/.env.local
#
# .env.local is git-ignored. Only variables prefixed with VITE_ are exposed to
# the browser bundle, so NEVER put a secret in this file - anyone can read it.

# Base URL used for every API request (src/config/env.ts).
# The default is relative, so the Vite dev server proxies /api/* to FastAPI and
# production uses a reverse proxy - no backend hostname is hardcoded in the app.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api/* requests (read by vite.config.ts on
# the Node side; it is not shipped to the browser).
# Local development uses the backend on port 8000; docker compose overrides it
# with http://backend:8000.
VITE_DEV_PROXY_TARGET=http://localhost:8000
